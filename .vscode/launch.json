{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Debug (Spring Boot) - spring-rest",
            "request": "launch",
            "mainClass": "com.example.springrest.Application",
            "projectName": "spring-rest",
            "cwd": "${workspaceFolder}/spring-rest",
            "env": {
                "SPRING_PROFILES_ACTIVE": "local"
            }
        },
        {
            "name": "Next.js: Client (Chrome)",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/nextjs-client"
        }
    ]
}